APP_NAME=payment-gateway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr_json,daily_json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=payment_gateway
DB_USERNAME=payment_gateway
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE_RETRY_AFTER=90

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
# Uzupełnij z Mailtrap Sandbox → SMTP Settings
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=5
MAIL_FROM_ADDRESS="payments@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Webhooki płatności — dostawca "generic" (nagłówek X-Payment-Provider: generic)
# Sekret bieżący podpisu HMAC (wymagany) i poprzedni na czas rotacji (opcjonalny)
WEBHOOK_GENERIC_SECRET=whsec_dev_secret
WEBHOOK_GENERIC_PREVIOUS_SECRET=
# Dopuszczalna różnica (s) między znacznikiem czasu podpisu a zegarem serwera
WEBHOOK_SIGNATURE_TOLERANCE=300

# Powiadomienia działu sprzedaży
# Czy zdarzenia testowe (livemode=false) wyzwalają powiadomienia; brak wartości = tak poza produkcją
# NOTIFICATIONS_NOTIFY_TEST_EVENTS=true
NOTIFICATIONS_MAILTRAP_ENABLED=true
# Adresaci (po przecinku) maili wysyłanych przez Mailtrap Sandbox
NOTIFICATIONS_SALES_TEAM_EMAILS=sales@example.test
NOTIFICATIONS_SALESTEAM_ENABLED=true
# Mock kanału SalesTeam: success | transient | permanent | fail_first_n
SALESTEAM_MOCK_MODE=success
# Dla fail_first_n: liczba pierwszych prób kończonych błędem przejściowym
SALESTEAM_MOCK_FAIL_FIRST=2
